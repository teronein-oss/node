rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == 'teronein@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function regPath(uid) {
      return /databases/$(database)/documents/registrations/$(uid);
    }

    function hasRegistration(uid) {
      return exists(regPath(uid));
    }

    function myRegistration() {
      return get(regPath(request.auth.uid)).data;
    }

    function myAcademyId() {
      return hasRegistration(request.auth.uid) && ('academyId' in myRegistration())
        ? myRegistration().academyId
        : 'node-default';
    }

    function isApproved() {
      return signedIn()
        && hasRegistration(request.auth.uid)
        && myRegistration().status == 'approved';
    }

    function isAcademyMember(academyId) {
      return isSuperAdmin() || (isApproved() && myAcademyId() == academyId);
    }

    function isAcademyAdmin(academyId) {
      return isSuperAdmin()
        || (
          isApproved()
          && myAcademyId() == academyId
          && (myRegistration().role == '관리자' || myRegistration().role == '원장')
        );
    }

    function isDefaultMember() {
      return isSuperAdmin() || (isApproved() && myAcademyId() == 'node-default');
    }

    function isAssignedJogyo(userId) {
      return isApproved()
        && myRegistration().role == '조교'
        && (
          myRegistration().assignedTeacherUid == userId
          || (
            'assignedTeacherUids' in myRegistration()
            && userId in myRegistration().assignedTeacherUids
          )
        );
    }

    match /academies/{academyId} {
      allow read: if isAcademyMember(academyId);
      // 학원 생성과 가입 확정은 검증된 Cloud Function에서만 수행합니다.
      allow create: if false;
      allow update, delete: if isAcademyAdmin(academyId);

      match /config/{docId} {
        allow read: if isAcademyMember(academyId);
        allow write: if isAcademyAdmin(academyId);
      }

      match /appData/{userId} {
        allow read: if isSuperAdmin()
          || (isAcademyMember(academyId) && request.auth.uid == userId)
          || isAcademyAdmin(academyId)
          || (isAcademyMember(academyId) && isAssignedJogyo(userId));
        allow write: if isSuperAdmin()
          || (isAcademyMember(academyId) && request.auth.uid == userId)
          || (isAcademyMember(academyId) && isAssignedJogyo(userId));
      }

      match /homeworkData/{userId} {
        allow read: if isSuperAdmin()
          || (isAcademyMember(academyId) && request.auth.uid == userId)
          || isAcademyAdmin(academyId)
          || (isAcademyMember(academyId) && isAssignedJogyo(userId));
        allow write: if isSuperAdmin()
          || (isAcademyMember(academyId) && request.auth.uid == userId)
          || (isAcademyMember(academyId) && isAssignedJogyo(userId));
      }

      match /users/{userId} {
        allow read: if isSuperAdmin()
          || (isAcademyMember(academyId) && request.auth.uid == userId)
          || isAcademyAdmin(academyId);
        allow write: if isSuperAdmin() || isAcademyAdmin(academyId);
      }

      match /sharedStudentRosters/{userId} {
        allow read: if isSuperAdmin()
          || (isAcademyMember(academyId) && request.auth.uid == userId)
          || isAcademyAdmin(academyId)
          || (isAcademyMember(academyId) && isAssignedJogyo(userId));
        allow write: if isSuperAdmin()
          || (isAcademyMember(academyId) && request.auth.uid == userId)
          || (isAcademyMember(academyId) && isAssignedJogyo(userId));
      }

      match /studentDashboardRows/{rowId} {
        allow read, write: if isAcademyMember(academyId);
      }

      match /messageLogs/{logId} {
        allow read: if isAcademyAdmin(academyId);
        allow write: if false;
      }

      match /studentReports/{reportId} {
        allow read, write: if false;
      }

      match /actualExamScores/{scoreId} {
        allow read, write: if false;
      }
    }

    // 발송결과 동기화 작업은 Admin SDK를 사용하는 Cloud Functions 전용입니다.
    match /messageSyncJobs/{jobId} {
      allow read, write: if false;
    }

    // 성적 리포트와 식별 코드는 Cloud Functions에서만 접근합니다.
    match /studentReportAccess/{accessHash} {
      allow read, write: if false;
    }

    match /studentReportRateLimits/{viewerHash} {
      allow read, write: if false;
    }

    match /studentReportViewLogs/{logId} {
      allow read, write: if false;
    }

    match /teacherReportRateLimits/{viewerHash} {
      allow read, write: if false;
    }

    match /teacherReportViewLogs/{logId} {
      allow read, write: if false;
    }

    // 가입 정책, 제공사 검증 결과와 중복가입 키는 서버에서만 관리합니다.
    match /signupConfig/{docId} {
      allow read, write: if false;
    }

    match /identityVerificationTickets/{ticketHash} {
      allow read, write: if false;
    }

    match /identityClaims/{subjectHash} {
      allow read, write: if false;
    }

    match /registrations/{userId} {
      allow create: if false;
      allow read: if signedIn() && request.auth.uid == userId;
      allow read, write: if isSuperAdmin();
      allow read: if signedIn()
        && resource.data.academyId == myAcademyId()
        && isAcademyAdmin(resource.data.academyId);
      allow delete: if signedIn()
        && resource.data.academyId == myAcademyId()
        && isAcademyAdmin(resource.data.academyId)
        && resource.data.role in ['선생님', '조교']
        && request.auth.uid != userId;
      allow update: if signedIn()
        && resource.data.academyId == myAcademyId()
        && isAcademyAdmin(resource.data.academyId)
        && request.auth.uid != userId
        && resource.data.role in ['선생님', '조교']
        && request.resource.data.role in ['선생님', '조교']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'role', 'assignedTeacherUid', 'assignedTeacherUids'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (
            resource.data.status in ['pending', 'rejected']
            && request.resource.data.status in ['approved', 'rejected']
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow read, write: if isSuperAdmin();
      allow read, write: if isDefaultMember()
        && (myRegistration().role == '관리자' || myRegistration().role == '원장')
        && hasRegistration(userId)
        && get(regPath(userId)).data.academyId == 'node-default';
    }

    match /config/{docId} {
      allow read: if isDefaultMember();
      allow write: if isSuperAdmin() || (isDefaultMember() && (myRegistration().role == '관리자' || myRegistration().role == '원장'));
    }

    match /appData/{userId} {
      allow read, write: if isDefaultMember() && request.auth.uid == userId;
      allow read, write: if isSuperAdmin();
      allow read: if isDefaultMember() && (myRegistration().role == '관리자' || myRegistration().role == '원장');
      allow read, write: if isDefaultMember() && isAssignedJogyo(userId);
      allow read: if isDefaultMember()
        && get(/databases/$(database)/documents/config/sharedData).data.adminUid == userId;
    }

    match /homeworkData/{userId} {
      allow read, write: if isDefaultMember() && request.auth.uid == userId;
      allow read, write: if isSuperAdmin();
      allow read: if isDefaultMember() && (myRegistration().role == '관리자' || myRegistration().role == '원장');
      allow read, write: if isDefaultMember() && isAssignedJogyo(userId);
      allow read: if isDefaultMember()
        && get(/databases/$(database)/documents/config/sharedData).data.adminUid == userId;
    }

    match /sharedStudentRosters/{userId} {
      allow read: if isDefaultMember();
      allow write: if isSuperAdmin()
        || (isDefaultMember() && request.auth.uid == userId)
        || (isDefaultMember() && isAssignedJogyo(userId));
    }

    match /studentDashboardRows/{rowId} {
      allow read, write: if isDefaultMember();
    }
  }
}
